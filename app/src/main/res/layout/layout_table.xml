<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="0,1"
    android:padding="10dp"
    android:background="#FFF3E0">

    <TableRow>
        <TextView android:text="Producto" android:textStyle="bold" android:padding="8dp"/>
        <TextView android:text="Precio" android:textStyle="bold" android:padding="8dp"/>
    </TableRow>

    <TableRow>
        <TextView android:text="Manzanas" android:padding="8dp"/>
        <TextView android:text="$2.00" android:padding="8dp"/>
    </TableRow>

    <TableRow>
        <TextView android:text="Naranjas" android:padding="8dp"/>
        <TextView android:text="$1.50" android:padding="8dp"/>
    </TableRow>
</TableLayout>